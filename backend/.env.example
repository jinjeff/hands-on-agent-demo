# ---- 运行模式（一个开关贯穿 P1–P6）----
# echo  = P1 阶段：SSE 回声，不需要任何 Key
# p3    = P3 阶段：离线两轮 ReAct mock，不需要任何 Key
# p4    = P4 阶段：离线 MCP 检索 + A2A 委派 mock，不需要任何 Key
# agent = 真 AgentScope Agent，需要下面的模型 Key（P4 工具还需同时起 mcp_server / a2a_server）
MODE=echo

# ---- 大模型（OpenAI 兼容接口：通义 / 硅基流动 / 自建都可；仅 MODE=agent 需要）----
# 直连厂商：
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus

# 走 LiteLLM 网关（推荐生产形态，见实战步骤附录「用 LiteLLM 做 AI 网关」）：
# 先把下面三行取消注释、上面三行注释掉，再启动 litellm --config litellm.yaml --port 4000
# OPENAI_API_KEY=sk-litellm-course          # 网关的 master_key，不是真 Key
# OPENAI_BASE_URL=http://127.0.0.1:4000/v1  # 注意必须带 /v1
# OPENAI_MODEL=smart                        # 网关里的别名，不是真模型名

# ---- 检索链路 RAG_MODE 三选一（改完重启生效）----
# api        P3 直连：tools_impl 直接 POST RAGFlow /api/v1/retrieval（不经过任何中间层）
# mcp        走本仓 mcp_server.py 暴露的 search_contract（默认）
# ragflow-mcp 走 RAGFlow 自带 MCP（标准 JSON-RPC；需先在 RAGFlow 的 compose 里
#            加 --enable-mcpserver 等参数开启，端口 9382，见实战步骤 4.7.1）
RAG_MODE=mcp
RAGFLOW_MCP_URL=http://127.0.0.1:9382/mcp
RAGFLOW_MCP_TOOL=ragflow_retrieval

# ---- P2 知识库（真实 RAGFlow，按实战步骤第二部分 2.2 配好）----
# MODE=agent 时由 MCP Server 访问 RAGFlow，主 Agent 不直接依赖这些配置
# 控制台：http://127.0.0.1（80 端口）；Key：头像 → API → Create（只显示一次）
# DATASET_ID：python list_datasets.py --api-key 你的Key 查到的 UUID
RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=
RAGFLOW_DATASET_ID=

# ---- P4 MCP / A2A 内部服务 ----
MCP_SERVER_URL=http://127.0.0.1:8002
A2A_SERVER_URL=http://127.0.0.1:8001
A2A_TOKEN=p4-a2a-demo-token
MCP_PORT=8002
A2A_PORT=8001
APP_PORT=8000
